{
  "name": "nimelix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-local.mjs",
    "build": "next build",
    "start": "node scripts/run-local.mjs --production",
    "typecheck": "tsc --noEmit",
    "dev:web": "next dev",
    "api:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-api.ps1",
    "api:check": "node scripts/check-api.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "wrangler pages dev pages-dist --port 8788",
    "deploy:pages": "wrangler pages deploy pages-dist --project-name nimelix --branch main"
  },
  "dependencies": {
    "@vidstack/react": "^1.15.7",
    "@vinext/cloudflare": "^1.2.1",
    "fscreen": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.24",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.154.0"
  },
  "type": "module"
}
